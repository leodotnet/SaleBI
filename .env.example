# Amazon PA-API (official)
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=
PAAPI_REGION=US
PAAPI_HOST=webservices.amazon.com

# LLM providers (optional)
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Rainforest API (third-party Amazon data)
RAINFOREST_API_KEY=
RAINFOREST_DOMAIN=amazon.com
